import "package://pkg.pkl-lang.org/pkl-pantry/com.circleci.v2@1.5.0#/Config.pkl"

/// Docker image tag to use
tag: String = "latest"

/// Whether this is a release build or not.
isRelease: Boolean = false

/// Docker registry to push to (optional)
registry: String?

/// Docker repository name
repository: String = "pkl"

job: Config.Job = new {
  docker {
    new {
      image = "cimg/base:current"
    }
  }
  steps {
    "checkout"
    new Config.RunStep {
      name = "Setup Docker Buildx"
      command = """
        docker buildx create --use --driver docker-container
        """
    }
    new Config.RunStep {
      name = "Build Docker image"
      command = 
        let (imageTag = if (module.isRelease) module.tag else "snapshot-\(module.tag)")
        let (fullImageName = if (module.registry != null) "\(module.registry)/\(module.repository):\(imageTag)" else "\(module.repository):\(imageTag)")
        """
        docker buildx build --platform linux/amd64,linux/arm64 --tag \(fullImageName) --load .
        """
    }
    when (module.registry != null) {
      new Config.RunStep {
        name = "Push Docker image"
        command =
          let (imageTag = if (module.isRelease) module.tag else "snapshot-\(module.tag)")
          let (fullImageName = if (module.registry != null) "\(module.registry)/\(module.repository):\(imageTag)" else "\(module.repository):\(imageTag)")
          """
          echo $GITHUB_TOKEN | docker login \(module.registry) -u $GITHUB_ACTOR --password-stdin
          docker buildx build \\
            --platform linux/amd64,linux/arm64 \\
            --tag \(fullImageName) \\
            --push \\
            .
          """
      }
    }
  }
}
